<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShiftGrid Cipher - Complete Technical Suite</title>
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
            background: #121212;
            color: #fff;
            line-height: 1.6;
        }
        .container {
            max-width: 650px;
            margin: auto;
        }
        .section {
            background: #1e1e1e;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #333;
        }
        h2, h3 {
            color: #4CAF50;
            margin-top: 0;
        }
        textarea {
            width: 100%;
            height: 80px;
            margin-bottom: 10px;
            padding: 8px;
            background: #222;
            color: #fff;
            border: 1px solid #444;
            border-radius: 4px;
            box-sizing: border-box;
        }
        button {
            width: 100%;
            padding: 10px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            margin-bottom: 10px;
        }
        button:hover {
            background: #218838;
        }
        #outputResult {
            background: #181818;
            padding: 10px;
            border-radius: 4px;
            border: 1px dashed #444;
            word-break: break-all;
            min-height: 20px;
        }
        code, pre {
            background: #222;
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            color: #a5d6a7;
        }
        pre {
            padding: 10px;
            overflow-x: auto;
        }
        ul {
            padding-left: 20px;
        }
    </style>
</head>
<body>

<div class="container">
    
    <!-- DETAILED DOCUMENTATION & SPECIFICATION -->
    <div class="section">
        <h2>ShiftGrid Cipher Specification</h2>
        <p><strong>Official Creation Date:</strong> September 8, 2026 (4:09 AM EDT)</p>
        <p><strong>Architecture:</strong> <code>3A | 3S</code> Grid System</p>
        
        <h3>The Core Gimmick & Mechanics</h3>
        <p>ShiftGrid replaces standard linear substitution by mapping characters across a multi-tiered structural grid. It utilizes a <strong>slash-tally depth indexing coordinate system</strong> where the column number is followed by forward slashes (<code>/</code>) indicating the specific row depth.</p>

        <h3>Key Architecture Definitions</h3>
        <ul>
            <li><strong>3A (Alphabet Matrix):</strong> The alphabet distributed across a 3-row structured layout.</li>
            <li><strong>3S (Special Characters / Punctuation Layer):</strong> A dedicated 3-row punctuation and symbol matrix where coordinates use parentheses and slashes.</li>
            <li><strong>Even Row Switching Rule:</strong> Even-numbered rows shift their internal layout orientation conceptually during matrix design, <strong>but all coordinates are consistently read and parsed strictly from left to right</strong>.</li>
        </ul>

        <h3>The Alphabet Grid Layout (3A)</h3>
        <pre>Row 1 (/):   A  D  G  J  M  P  S  V  Y
Row 2 (//):  Z  W  T  Q  N  K  H  E  B
Row 3 (///): C  F  I  L  O  R  U  X</pre>

        <h3>The Special Characters Grid (3S)</h3>
        <pre>Row 1 (1–3):    (1) "   (2) ?   (3) ;
Row 2 (1/–3/):  (1/) :  (2/) '   (3/) .
Row 3 (1//–3//):(1//),  (2//)-  (3//)!
Space:          [Space token]</pre>
    </div>

    <!-- INTERACTIVE BIDIRECTIONAL TOOL -->
    <div class="section">
        <h3>ShiftGrid Translation Tool</h3>
        
        <label for="plainInput"><strong>Plaintext Input (To Encode):</strong></label>
        <textarea id="plainInput" placeholder="Enter text to encode..."></textarea>
        <button onclick="encodeMessage()">Encode to ShiftGrid</button>

        <label for="cipherInput" style="margin-top: 15px; display: block;"><strong>Ciphertext Input (To Decode):</strong></label>
        <textarea id="cipherInput" placeholder="[3A | 3S] Enter ciphertext here..."></textarea>
        <button onclick="decodeMessage()" style="background: #17a2b8;">Decode to English</button>

        <h3>Result:</h3>
        <p id="outputResult"></p>
    </div>

</div>

<script>
    // Complete 3A Alphabet & 3S Special Character Mapping Definition
    const encodeMap = {
        // 3A Alphabet Grid
        'A': '1/', 'D': '2/', 'G': '3/', 'J': '4/', 'M': '5/', 'P': '6/', 'S': '7/', 'V': '8/', 'Y': '9/',
        'Z': '1//', 'W': '2//', 'T': '3//', 'Q': '4//', 'N': '5//', 'K': '6//', 'H': '7//', 'E': '8//', 'B': '9//',
        'C': '1///', 'F': '2///', 'I': '3///', 'L': '4///', 'O': '5///', 'R': '6///', 'U': '7///', 'X': '8///',
        
        // 3S Special Characters Grid Layer
        '"': '(1)', '?': '(2)', ';': '(3)',
        ':': '(1/)', "'": '(2/)', '.': '(3/)',
        ',': '(1//)', '-': '(2//)', '!': '(3//)',
        ' ': ' '
    };

    const decodeMap = {};
    for (let key in encodeMap) {
        decodeMap[encodeMap[key]] = key;
    }

    function encodeMessage() {
        let plainText = document.getElementById('plainInput').value;
        let result = "[3A | 3S] ";
        let currentWord = "";
        let punctuationQueue = [];

        for (let i = 0; i < plainText.length; i++) {
            let char = plainText[i];
            let upperChar = char.toUpperCase();
            
            let mappingKey = encodeMap[upperChar] !== undefined ? upperChar : (encodeMap[char] !== undefined ? char : null);

            if (mappingKey !== null) {
                let code = encodeMap[mappingKey];
                if (code.startsWith('(')) {
                    punctuationQueue.push(code);
                } else if (code === ' ') {
                    if (currentWord || punctuationQueue.length > 0) {
                        result += currentWord + punctuationQueue.join('') + " ";
                        currentWord = "";
                        punctuationQueue = [];
                    }
                } else {
                    currentWord += code;
                }
            }
        }
        if (currentWord || punctuationQueue.length > 0) {
            result += currentWord + punctuationQueue.join('');
        }
        document.getElementById('outputResult').innerText = result;
    }

    function decodeMessage() {
        let cipherText = document.getElementById('cipherInput').value.trim();
        if (cipherText.startsWith("[3A | 3S]")) {
            cipherText = cipherText.replace("[3A | 3S]", "").trim();
        } else if (cipherText.startsWith("[4A | 3S]")) {
            cipherText = cipherText.replace("[4A | 3S]", "").trim();
        }

        let tokens = cipherText.split(' ');
        let decodedMessage = "";

        for (let t of tokens) {
            let currentToken = t;
            let trailingPunctuation = "";

            while (currentToken.includes('(')) {
                let openIndex = currentToken.indexOf('(');
                let closeIndex = currentToken.indexOf(')', openIndex);
                if (openIndex !== -1 && closeIndex !== -1) {
                    let punct = currentToken.substring(openIndex, closeIndex + 1);
                    trailingPunctuation += punct;
                    currentToken = currentToken.substring(0, openIndex) + currentToken.substring(closeIndex + 1);
                } else {
                    break;
                }
            }

            let i = 0;
            while (i < currentToken.length) {
                let chunk = "";
                if (currentToken[i] >= '1' && currentToken[i] <= '9') {
                    chunk += currentToken[i];
                    i++;
                    while (i < currentToken.length && currentToken[i] === '/') {
                        chunk += '/';
                        i++;
                    }
                } else {
                    i++;
                }

                if (decodeMap[chunk] !== undefined) {
                    decodedMessage += decodeMap[chunk];
                }
            }

            if (trailingPunctuation) {
                let pTokens = trailingPunctuation.match(/\(.*?\)/g);
                if (pTokens) {
                    for (let pt of pTokens) {
                        if (decodeMap[pt] !== undefined) {
                            decodedMessage += decodeMap[pt];
                        }
                    }
                }
            }
            decodedMessage += " ";
        }

        document.getElementById('outputResult').innerText = decodedMessage.trim();
    }
</script>

</body>
</html>
